            real dimension(85) :: alpha_prof
            common /spec/ te,ti,fi,ven,vin,alpha,dens,bfld,nion,wi,ak
            common /spline/ ta,bcoef
            common /mag/ bfld_prof,alpha_prof
        end subroutine lagp
